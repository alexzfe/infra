# Managed by Ansible from sites.yml. IMAGE_TAG is set by deploy-app.
name: {{ app.name }}-{{ env }}

services:
  app:
    image: {{ app.image }}:${IMAGE_TAG:?run deploy-app to set IMAGE_TAG}
    restart: unless-stopped
{% if env == 'staging' %}
    # Staging shares the box with prod; cap it so it can't starve prod.
    mem_limit: {{ app.staging_mem_limit | default('256m') }}
{% else %}
    # A cap so one runaway app can't take the whole box (and the tunnel) down with it.
    mem_limit: {{ app.mem_limit | default('1g') }}
{% endif %}
{% if app.env is defined %}
    environment:
{% for key, value in app.env.items() %}
      {{ key }}: {{ (value | string | replace('{host}', app.hosts[env]) | replace('$', '$$')) | to_json }}
{% endfor %}
{% endif %}
{% if app.env_file is defined %}
    # Secrets this public repo can't hold, written on the box by hand (root, 0600). Absent is fine.
    env_file:
      - path: {{ app.env_file }}
        required: false
{% endif %}
{% if app.volume is defined %}
    volumes:
      - data:{{ app.volume }}
{% endif %}
{% if app.healthcheck | default('') != 'image' %}
    healthcheck:
      test: ["CMD", "wget", "-qO", "/dev/null", "http://127.0.0.1:{{ app.port }}{{ app.health_path | default('/') }}"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 10s
{% endif %}
    networks:
      edge:
        aliases:
          - {{ app.name }}-{{ env }}

networks:
  edge:
    external: true
{% if app.volume is defined %}

# Created by Ansible, not compose, so no compose command (`down --volumes` included) can delete it.
volumes:
  data:
    name: {{ app.name }}-{{ env }}-data
    external: true
{% endif %}
