# Managed by Ansible from sites.yml.
# Cloudflare terminates HTTPS and the tunnel carries requests here, so Caddy speaks plain HTTP and only routes.
{
	auto_https off
	admin off
}

{% for app in apps %}
http://{{ app.hosts.prod }} {
	encode zstd gzip
	reverse_proxy {{ app.name }}-prod:{{ app.port }}
}

http://{{ app.hosts.staging }} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy {{ app.name }}-staging:{{ app.port }}
}

{% endfor %}
:80 {
	respond "Not found" 404
}
