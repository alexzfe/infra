# Managed by Ansible from sites.yml.
# Cloudflare terminates HTTPS and the tunnel carries requests here, so nginx speaks plain HTTP and only routes.

# Resolve app containers per request through Docker's DNS, not once at startup. A static `proxy_pass` to an app that
# isn't deployed yet would stop nginx from starting at all; this way it's just a 502 for that one site.
resolver 127.0.0.11 valid=10s ipv6=off;

# Requests arrive from cloudflared on the Docker network; the visitor's address is in CF-Connecting-IP.
set_real_ip_from 172.16.0.0/12;
real_ip_header CF-Connecting-IP;

# WebSockets (multiplayer games): pass the upgrade through.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server_tokens off;
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_types text/css application/javascript application/json image/svg+xml text/plain text/xml;

# Any hostname not in sites.yml.
server {
    listen 80 default_server;
    return 404;
}
{# One location's proxying to an app. Request headers pass through as sent, CF-Connecting-IP included. #}
{% macro proxy_to(app, env) %}
        set $upstream http://{{ app.name }}-{{ env }}:{{ app.port }};
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
{% endmacro %}
{% for app in apps %}
{% for env in ['prod', 'staging'] %}

server {
    listen 80;
    server_name {{ app.hosts[env] }};
{% if env == 'staging' %}
    add_header X-Robots-Tag "noindex, nofollow" always;
{% endif %}
{% if app.max_body_size is defined %}
    client_max_body_size {{ app.max_body_size }};
{% endif %}

    location / {
{{ proxy_to(app, env) }}    }
{% for path in app.stream_paths | default([]) %}

    # Server-Sent Events: pass each event on as it comes, and outlast the app's keep-alives.
    location = {{ path }} {
{{ proxy_to(app, env) }}        proxy_buffering off;
        proxy_read_timeout 1h;
    }
{% endfor %}
}
{% endfor %}
{% endfor %}
