# Managed by Ansible. Nothing publishes a port: cloudflared dials out to Cloudflare and reaches nginx
# over the internal `edge` network, which every app joins too.
name: edge

services:
  nginx:
    image: {{ edge_nginx_image }}
    restart: unless-stopped
    # If the box runs out of memory, the kernel should kill an app before the proxy or the tunnel.
    oom_score_adj: -500
    volumes:
      # The folder, not the file: Ansible replaces the file on each change, and a single-file mount keeps
      # showing nginx the old one, so a reload would re-read the old config.
      - ./conf.d:/etc/nginx/conf.d:ro
    networks:
      edge:
        # The tunnel's origin is http://proxy:80, so swapping the proxy never touches Terraform.
        aliases:
          - proxy

  cloudflared:
    image: {{ edge_cloudflared_image }}
    restart: unless-stopped
    oom_score_adj: -500
    command: tunnel --no-autoupdate run
    environment:
      TUNNEL_TOKEN: ${TUNNEL_TOKEN}
    depends_on:
      - nginx
    networks:
      - edge

networks:
  edge:
    name: edge
