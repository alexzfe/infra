{
	"tagOwners": {
		// Owned by tag:infra-ci too, so the infra OAuth client can mint server-only join keys.
		"tag:server":   ["autogroup:admin", "tag:infra-ci"],
		"tag:infra-ci": ["autogroup:admin"],
		"tag:ci":       ["autogroup:admin"],
		// The homeserver's backup puller: a second, userspace tailscaled there (homeserver/README.md), not the
		// homeserver itself, which stays an ordinary member device.
		"tag:backup":   ["autogroup:admin"],
	},

	"grants": [
		// People (and devices shared with friends) keep reaching everything, as before.
		{"src": ["autogroup:member", "autogroup:shared"], "dst": ["*"], "ip": ["*"]},
		// CI may reach only the VPS, and only SSH. Nothing at home.
		{"src": ["tag:infra-ci", "tag:ci"], "dst": ["tag:server"], "ip": ["tcp:22"]},
		// The backup puller may reach only the VPS's SSH, and only as backup-pull (below).
		{"src": ["tag:backup"], "dst": ["tag:server"], "ip": ["tcp:22"]},
	],

	"ssh": [
		{"action": "check", "src": ["autogroup:member"], "dst": ["autogroup:self"], "users": ["autogroup:nonroot", "root"]},
		{"action": "accept", "src": ["autogroup:admin"], "dst": ["tag:server"], "users": ["root", "deploy"]},
		{"action": "accept", "src": ["tag:infra-ci"], "dst": ["tag:server"], "users": ["root"]},
		{"action": "accept", "src": ["tag:ci"], "dst": ["tag:server"], "users": ["deploy"]},
		{"action": "accept", "src": ["tag:backup"], "dst": ["tag:server"], "users": ["backup-pull"]},
	],

	"tests": [
		{"src": "tag:ci", "accept": ["tag:server:22"], "deny": ["tag:server:80"]},
		{"src": "tag:infra-ci", "accept": ["tag:server:22"]},
		{"src": "tag:backup", "accept": ["tag:server:22"], "deny": ["tag:server:80", "tag:ci:22", "tag:infra-ci:22"]},
	],

	"sshTests": [
		{"src": "tag:backup", "dst": ["tag:server"], "accept": ["backup-pull"], "deny": ["root", "deploy"]},
	],
}
